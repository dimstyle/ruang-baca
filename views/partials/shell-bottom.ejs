    </main>
  </div>
</div>

<!-- confirm-dialog -->
<dialog id="confirm-dialog" class="dialog">
  <h2 class="text-lg font-medium" data-confirm-title>Hapus data?</h2>
  <p class="mt-2 text-sm text-muted" data-confirm-text></p>
  <div class="mt-6 flex justify-end gap-2">
    <button type="button" class="btn-text" data-close>Batal</button>
    <button type="button" class="btn-danger" data-confirm-ok>Hapus</button>
  </div>
</dialog>

<%- include('snackbar') %>
</body>
</html>
