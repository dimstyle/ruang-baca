<span class="inline-flex shrink-0 items-center justify-center rounded-lg font-medium text-white <%= typeof size !== 'undefined' && size === 'lg' ? 'size-24 text-4xl rounded-2xl' : 'size-10 text-base' %>" style="background:<%= color(key) %>"><%= typeof icon !== 'undefined' ? '' : String(text || '?').charAt(0).toUpperCase() %><% if (typeof icon !== 'undefined') { %><%- include('icon', { n: icon, cls: 'size-5' }) %><% } %></span>
