<%- include('partials/head') %>
<body class="bg-bg text-ink font-sans antialiased min-h-screen flex items-center justify-center p-4">
  <form class="w-[400px] max-w-full rounded-2xl border border-line bg-surface p-8 flex flex-col gap-5" data-api="POST /api/auth/login" data-redirect="/app/katalog">
    <div class="flex flex-col items-center gap-2 text-center">
      <div class="flex items-center gap-2 text-[22px] font-medium text-accent">
        <%- include('partials/icon', { n: 'book', cls: 'size-7' }) %>
        <span>Ruang Baca</span>
      </div>
      <h1 class="text-2xl font-normal mt-2">Masuk</h1>
      <p class="text-sm text-muted">Gunakan akun perpustakaan kamu</p>
    </div>

    <div>
      <label class="label" for="email">Email</label>
      <input id="email" name="email" type="email" required class="field" placeholder="nama@kampus.ac.id" autocomplete="email">
    </div>

    <div>
      <label class="label" for="password">Password</label>
      <div class="relative flex items-center">
        <input id="password" name="password" type="password" required minlength="8" class="field pr-11" placeholder="Minimal 8 karakter" autocomplete="current-password">
        <button type="button" class="icon-btn absolute right-1" data-toggle-pw="#password" title="Tampilkan/sembunyikan password">
          <%- include('partials/icon', { n: 'eye' }) %>
        </button>
      </div>
    </div>

    <p class="hidden text-sm text-danger" data-error></p>

    <button type="submit" class="btn-primary w-full">Masuk</button>

    <p class="text-center text-xs text-muted">Belum punya akun? Hubungi admin perpustakaan</p>
  </form>
  <%- include('partials/snackbar') %>
</body>
</html>
