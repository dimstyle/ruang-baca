<%- include('partials/header', { title: title }) %>

<main class="flex-1 flex items-center justify-center p-6">
  <div class="max-w-lg w-full bg-white rounded-2xl shadow-sm border border-slate-200/80 p-8 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl mb-6 shadow-inner">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746-0.332-4.5 1.253"></path>
      </svg>
    </div>
    
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-3"><%= title %></h1>
    <p class="text-slate-600 leading-relaxed mb-8 text-base"><%= message %></p>

    <div class="p-4 bg-emerald-50/70 border border-emerald-200/60 text-emerald-800 text-sm rounded-xl flex items-center justify-center gap-2 mb-6">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-medium">Setup SSR EJS & Tailwind CSS lokal berhasil!</span>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs text-slate-500 text-left pt-6 border-t border-slate-100">
      <div class="p-3 bg-slate-50 rounded-lg">
        <span class="font-semibold block text-slate-700 mb-0.5">Template Engine</span>
        <span>EJS (Embedded JS)</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-lg">
        <span class="font-semibold block text-slate-700 mb-0.5">Styling</span>
        <span>Tailwind CSS v4 (Local)</span>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
