// Source of truth: specs/database-contracts.md
// Deviations agreed with the user: accounts.username, refresh_token.token

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  password      String
  role          String
  created_at    DateTime       @default(now())
  user          User?
  admin         Admin?
  refreshTokens RefreshToken[]

  @@map("accounts")
}

model User {
  id           String        @id @default(uuid())
  account_id   String        @unique
  nama_lengkap String
  no_hp        String
  alamat       String
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now())
  account      Account       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  peminjaman   Peminjaman[]
  daftar_denda DaftarDenda[]

  @@map("users")
}

model Admin {
  id           String       @id @default(uuid())
  account_id   String       @unique
  nama_lengkap String
  no_hp        String
  alamat       String
  created_at   DateTime     @default(now())
  updated_at   DateTime     @default(now())
  account      Account      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  peminjaman   Peminjaman[]
  laporan      Laporan[]

  @@map("admins")
}

model Category {
  id            Int    @id @default(autoincrement())
  nama_kategori String
  jenis_buku    String
  books         Book[]

  @@map("categories")
}

model Book {
  id            Int          @id @default(autoincrement())
  categories_id Int
  judul         String
  penulis       String
  penerbit      String
  tanggal_rilis DateTime
  stok          Int
  category      Category     @relation(fields: [categories_id], references: [id], onDelete: Restrict)
  peminjaman    Peminjaman[]

  @@map("books")
}

model Peminjaman {
  id                       Int            @id @default(autoincrement())
  user_id                  String
  admin_id                 String
  book_id                  Int
  tanggal_peminjaman       DateTime       @default(now())
  tanggal_batas_peminjaman DateTime
  user                     User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  admin                    Admin          @relation(fields: [admin_id], references: [id], onDelete: Restrict)
  book                     Book           @relation(fields: [book_id], references: [id], onDelete: Restrict)
  pengembalian             Pengembalian[]

  @@map("peminjaman")
}

model Pengembalian {
  id                   Int           @id @default(autoincrement())
  peminjaman_id        Int
  tanggal_dikembalikan DateTime
  status_buku          String // "Baik" | "Rusak" | "Hilang"
  peminjaman           Peminjaman    @relation(fields: [peminjaman_id], references: [id], onDelete: Cascade)
  daftar_denda         DaftarDenda[]

  @@map("pengembalian")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  account_id String
  token      String
  created_at DateTime @default(now())
  expired_at DateTime
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

model Laporan {
  id                         Int      @id @default(autoincrement())
  admin_id                   String
  keterangan                 String
  total_denda                Int
  tanggal_awal_peminjaman    DateTime
  tanggal_akhir_peminjaman   DateTime
  tanggal_awal_pengembalian  DateTime
  tanggal_akhir_pengembalian DateTime
  tanggal_pembuatan_laporan  DateTime
  admin                      Admin    @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@map("laporan")
}

model DaftarDenda {
  id              Int          @id @default(autoincrement())
  user_id         String
  pengembalian_id Int
  denda           Float
  keterangan      String
  user            User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  pengembalian    Pengembalian @relation(fields: [pengembalian_id], references: [id], onDelete: Restrict)

  @@map("daftar_denda")
}
