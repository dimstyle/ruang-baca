stateDiagram-v2
    state "Masuk sebagai Admin & buka daftar laporan" as s1
    state "Pilih salah satu laporan untuk melihat rincian" as s2
    state checkFound <<choice>>
    state "Tampilkan pesan laporan tidak ditemukan" as err
    state "Tampilkan rincian laporan lengkap" as ok

    [*] --> s1
    s1 --> s2
    s2 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    checkFound --> ok : 1 (Ditemukan)
    err --> [*]
    ok --> [*]
