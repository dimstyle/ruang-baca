flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka menu daftar laporan"]
        openMenu --> selectReport[/"Pilih salah satu laporan untuk melihat rincian"/]
        viewReport["Membaca rincian laporan lengkap"] --> finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        selectReport --> checkFound{"Apakah laporan tersebut ditemukan?"}
        checkFound -->|"Tidak"| notFound[/"Tampilkan pesan laporan tidak ditemukan"/]
        notFound --> finish
        checkFound -->|"Ya"| showDetail[/"Tampilkan identitas Admin, total denda, daftar peminjaman, dan pengembalian"/]
        showDetail --> viewReport
    end
