flowchart TD
    subgraph Admin["Admin"]
        start(["Mulai"]) --> openMenu["Buka menu daftar laporan"]
        openMenu --> selectReport["Pilih salah satu laporan untuk melihat rincian"]
        viewReport["Membaca rincian laporan lengkap"] --> finish(["Selesai"])
    end

    subgraph Sistem["Sistem"]
        selectReport --> checkFound{"Apakah laporan tersebut ditemukan?"}
        checkFound -->|"0 (Tidak)"| notFound["Tampilkan pesan laporan tidak ditemukan"]
        notFound --> finish
        checkFound -->|"1 (Ya)"| showDetail["Tampilkan identitas Admin, total denda, daftar peminjaman, dan pengembalian"]
        showDetail --> viewReport
    end
