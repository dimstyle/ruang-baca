stateDiagram-v2
    state "Masuk sebagai Admin" as s1
    state "Buka menu daftar anggota & pilih anggota" as s2
    state "Klik tombol hapus anggota" as s3
    state checkActive <<choice>>
    state "Tampilkan peringatan masih ada peminjaman/denda & batalkan" as conflict
    state "Hapus anggota dan tampilkan pesan berhasil dihapus" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> checkActive
    checkActive --> conflict : 1 (Masih ada peminjaman/denda)
    checkActive --> ok : 0 (Tidak ada tanggungan)
    conflict --> [*]
    ok --> [*]
