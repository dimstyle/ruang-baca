flowchart TD
    subgraph User["User"]
        start@{ shape: sm-circ } --> hasAccount{"Sudah punya akun anggota?"}
        hasAccount -->|"Tidak"| askAdmin["Minta pendaftaran akun ke Admin"]
        backLogin["Kembali ke halaman masuk"] --> inputAuth[/"Masukan email dan kata sandi"/]
        hasAccount -->|"Ya"| inputAuth
        inputAuth --> clickLogin[/"Klik tombol masuk"/]
        retryPass[/"Coba masukan kembali kata sandi"/] --> inputAuth
        finish@{ shape: fr-circ }
    end

    subgraph Admin["Admin"]
        askAdmin --> regByAdmin["Daftarkan akun anggota baru"]
        regByAdmin --> backLogin
    end

    subgraph Sistem["Sistem"]
        clickLogin --> checkMatch{"Apakah email dan kata sandi sesuai?"}
        checkMatch -->|"Tidak"| warnWrong[/"Tampilkan pesan email atau kata sandi salah"/]
        warnWrong --> retryPass
        checkMatch -->|"Ya"| toDashboard["Arahkan ke halaman dashboard"]
        toDashboard --> finish
    end
