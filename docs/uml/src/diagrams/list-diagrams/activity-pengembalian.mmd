flowchart TD
    subgraph User["User"]
        start(["Mulai"]) --> openActive["Buka menu daftar peminjaman aktif"]
        openActive --> selectBook["Pilih buku yang ingin dikembalikan"]
        selectBook --> inputDate[/"Masukan tanggal pengembalian buku"/]
        inputDate --> clickReturn[/"Klik tombol ajukan pengembalian"/]
        finish(["Selesai"])
    end

    subgraph Sistem["Sistem"]
        clickReturn --> checkFound{"Apakah data peminjaman buku ditemukan?"}
        checkFound -->|"0 (Tidak)"| notFound["Tampilkan pesan data peminjaman tidak ditemukan"]
        notFound --> finish
        checkFound -->|"1 (Ya)"| saveTemp["Catat pengajuan pengembalian sementara"]
        saveTemp --> submitted["Tampilkan pesan menunggu persetujuan Admin"]
    end

    subgraph Admin["Admin"]
        submitted --> waitApprove["Menerima daftar pengajuan pengembalian"]
        waitApprove --> finish
    end
