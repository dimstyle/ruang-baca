stateDiagram-v2
    state "Masuk ke akun & buka daftar peminjaman aktif" as s1
    state "Pilih buku & masukan tanggal pengembalian" as s2
    state "Klik tombol ajukan pengembalian" as s3
    state checkFound <<choice>>
    state "Tampilkan pesan data peminjaman tidak ditemukan" as err
    state "Tampilkan pesan pengajuan pengembalian menunggu persetujuan Admin" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    checkFound --> ok : 1 (Ditemukan)
    err --> [*]
    ok --> [*]
