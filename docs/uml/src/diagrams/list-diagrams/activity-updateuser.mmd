stateDiagram-v2
    state "Masuk sebagai Admin" as s1
    state "Buka menu daftar anggota & pilih anggota" as s2
    state "Ubah nama lengkap, nomor HP, atau alamat" as s3
    state "Klik tombol simpan perubahan" as s4
    state checkFound <<choice>>
    state "Tampilkan pesan anggota tidak ditemukan" as err
    state "Tampilkan pesan data anggota berhasil diperbarui" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> s4
    s4 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    checkFound --> ok : 1 (Ditemukan)
    err --> [*]
    ok --> [*]
