flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka menu daftar anggota"]
        openMenu --> selectUser[/"Pilih anggota yang ingin diubah datanya"/]
        selectUser --> editData[/"Ubah nama lengkap, nomor HP, atau alamat"/]
        editData --> clickSave[/"Klik tombol simpan perubahan"/]
    end

    subgraph Sistem["Sistem"]
        clickSave --> checkFound{"Apakah anggota tersebut ditemukan?"}
        checkFound -->|"Tidak"| notFound[/"Tampilkan pesan anggota tidak ditemukan"/]
        checkFound -->|"Ya"| saveProfile["Perbarui data profil anggota"]
        saveProfile --> updated[/"Tampilkan pesan data anggota berhasil diperbarui"/]
    end

    subgraph User["User"]
        notFound --> finish@{ shape: fr-circ }
        updated --> profileUpdated["Profil anggota telah diperbarui"]
        profileUpdated --> finish
    end
