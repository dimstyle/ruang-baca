flowchart TD
    subgraph User["User"]
        reqLoan["Mengajukan peminjaman buku"]
        activeLoan["Buku tercatat sedang dipinjam"] --> finish(["Selesai"])
    end

    subgraph Admin["Admin"]
        start(["Mulai"]) --> openReq["Buka menu daftar pengajuan peminjaman"]
        reqLoan -.-> openReq
        openReq --> selectReq["Pilih pengajuan peminjaman dari anggota"]
        selectReq --> inputLimit["Tentukan tanggal batas pengembalian buku"]
        inputLimit --> clickApprove["Klik tombol setujui peminjaman"]
    end

    subgraph Sistem["Sistem"]
        clickApprove --> checkFound{"Apakah pengajuan peminjaman ditemukan?"}
        checkFound -->|"0 (Tidak)"| notFound["Tampilkan pesan pengajuan peminjaman tidak ditemukan"]
        notFound --> finish
        checkFound -->|"1 (Ya)"| moveActive["Pindahkan ke daftar peminjaman aktif & hapus antrean"]
        moveActive --> msgOk["Tampilkan pesan peminjaman berhasil disetujui"]
        msgOk --> activeLoan
    end
