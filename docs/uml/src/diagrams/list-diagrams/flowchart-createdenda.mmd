flowchart TD
    start(["Mulai (<<extend>> dari Accept Pengembalian)"]) --> openDialog["Admin membuka dialog Terima pada Permintaan Pengembalian"]
    openDialog --> evalCond{"Apakah pengembalian Telat atau kondisi buku dipilih Rusak/Hilang?"}
    evalCond -->|"Tidak"| noFine["Input denda disembunyikan (tidak ada denda)"]
    noFine --> finish(["Selesai"])
    evalCond -->|"Ya"| showFine["Tampilkan form input Nominal Denda (Rp) & Keterangan Denda"]
    showFine --> inputFine[/"Admin mengisi nominal denda dan keterangan alasan denda"/]
    inputFine --> clickAccept[/"Klik tombol Terima pengembalian"/]
    clickAccept --> checkFound{"Apakah data pengembalian valid?"}
    checkFound -->|"Tidak"| notFound["Tampilkan pesan data peminjaman tidak ditemukan"]
    notFound --> finish
    checkFound -->|"Ya"| created["Simpan pengembalian beserta tagihan denda baru ke daftar_denda"]
    created --> finish
