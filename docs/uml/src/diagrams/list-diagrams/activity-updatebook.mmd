flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka daftar katalog buku"]
        openMenu --> selectBook[/"Pilih buku yang ingin diperbarui"/]
        selectBook --> editBook[/"Ubah informasi buku atau kategori"/]
        editBook --> clickSave[/"Klik tombol simpan perubahan"/]
        fixCat[/"Pilih kategori buku yang tersedia"/] --> editBook
        finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        clickSave --> checkBook{"Apakah data buku ditemukan?"}
        checkBook -->|"Tidak"| notFound[/"Tampilkan pesan buku tidak ditemukan"/]
        notFound --> openMenu
        checkBook -->|"Ya"| checkCat{"Apakah kategori buku tersedia?"}
        checkCat -->|"Tidak"| warnCat[/"Tampilkan pesan kategori buku tidak ditemukan"/]
        warnCat --> fixCat
        checkCat -->|"Ya"| saveBook["Perbarui informasi buku di katalog"]
        saveBook --> updated[/"Tampilkan pesan informasi buku berhasil diperbarui"/]
        updated --> finish
    end
