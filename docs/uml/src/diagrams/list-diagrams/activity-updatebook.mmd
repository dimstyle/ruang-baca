stateDiagram-v2
    state "Masuk sebagai Admin & buka menu katalog buku" as s1
    state "Pilih buku & ubah informasi atau jumlah stok" as s2
    state "Klik tombol simpan perubahan" as s3
    state checkFound <<choice>>
    state "Tampilkan pesan buku tidak ditemukan" as err
    state "Tampilkan pesan data buku berhasil diperbarui" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    checkFound --> ok : 1 (Ditemukan)
    err --> [*]
    ok --> [*]
