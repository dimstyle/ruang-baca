flowchart TD
    subgraph Admin["Admin"]
        start(["Mulai"]) --> openMenu["Buka daftar katalog buku"]
        openMenu --> selectBook["Pilih buku yang ingin diperbarui"]
        selectBook --> editBook[/"Ubah informasi buku atau kategori"/]
        editBook --> clickSave[/"Klik tombol simpan perubahan"/]
        fixCat[/"Pilih kategori buku yang tersedia"/] --> editBook
        finish(["Selesai"])
    end

    subgraph Sistem["Sistem"]
        clickSave --> checkBook{"Apakah data buku ditemukan?"}
        checkBook -->|"0 (Tidak)"| notFound["Tampilkan pesan buku tidak ditemukan"]
        notFound --> openMenu
        checkBook -->|"1 (Ya)"| checkCat{"Apakah kategori buku tersedia?"}
        checkCat -->|"0 (Tidak)"| warnCat["Tampilkan pesan kategori buku tidak ditemukan"]
        warnCat --> fixCat
        checkCat -->|"1 (Ya)"| saveBook["Perbarui informasi buku di katalog"]
        saveBook --> updated["Tampilkan pesan informasi buku berhasil diperbarui"]
        updated --> finish
    end
