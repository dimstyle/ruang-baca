flowchart TD
    subgraph User["User / Admin"]
        start@{ shape: sm-circ } --> activePage["Berada di halaman aplikasi (sudah masuk)"]
        activePage --> clickLogout[/"Klik tombol keluar pada menu profil"/]
        clickLogout --> confirmLogout{"Apakah yakin ingin keluar?"}
        confirmLogout -->|"Tidak"| stayPage["Tetap berada di halaman saat ini"]
        stayPage --> finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        confirmLogout -->|"Ya"| endSession["Akhiri sesi masuk pengguna"]
        endSession --> toLogin["Arahkan kembali ke halaman masuk"]
        toLogin --> finish
    end
