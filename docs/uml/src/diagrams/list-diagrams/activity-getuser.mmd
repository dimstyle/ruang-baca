stateDiagram-v2
    state "Masuk sebagai Admin" as s1
    state "Buka menu daftar anggota" as s2
    state "Cari dan pilih anggota yang ingin dilihat" as s3
    state checkFound <<choice>>
    state "Tampilkan pesan anggota tidak ditemukan" as err
    state "Tampilkan informasi lengkap anggota" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    checkFound --> ok : 1 (Ditemukan)
    err --> [*]
    ok --> [*]
