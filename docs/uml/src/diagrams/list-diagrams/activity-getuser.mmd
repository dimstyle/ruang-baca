flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka menu daftar anggota"]
        openMenu --> searchUser[/"Cari dan pilih anggota yang ingin dilihat"/]
        viewDetail["Melihat rincian profil anggota"] --> finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        searchUser --> checkFound{"Apakah data anggota ditemukan?"}
        checkFound -->|"Tidak"| notFound[/"Tampilkan pesan anggota tidak ditemukan"/]
        notFound --> finish
        checkFound -->|"Ya"| showDetail[/"Tampilkan informasi lengkap anggota"/]
        showDetail --> viewDetail
    end
