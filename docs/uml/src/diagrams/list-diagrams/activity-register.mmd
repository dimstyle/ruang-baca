stateDiagram-v2
    state "Masuk sebagai Admin" as s1
    state "Buka halaman pendaftaran anggota" as s2
    state "Masukan biodata dan akun anggota" as s3
    state "Klik tombol daftarkan anggota" as s4
    state checkValid <<choice>>
    state "Tampilkan peringatan kolom belum sesuai & perbaiki isian" as s5
    state checkDuplicate <<choice>>
    state "Tampilkan pesan akun sudah terdaftar & ganti email/username" as s6
    state "Tampilkan pesan akun anggota berhasil dibuat" as s7

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> s4
    s4 --> checkValid
    checkValid --> s5 : 0 (Kolom belum sesuai)
    s5 --> s3
    checkValid --> checkDuplicate : 1 (Kolom valid)
    checkDuplicate --> s6 : 1 (Sudah terdaftar)
    s6 --> s3
    checkDuplicate --> s7 : 0 (Belum terdaftar)
    s7 --> [*]
