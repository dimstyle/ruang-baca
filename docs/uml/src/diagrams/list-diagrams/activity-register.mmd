flowchart TD
    subgraph Admin["Admin"]
        start(["Mulai"]) --> openPage["Buka halaman pendaftaran anggota"]
        openPage --> inputData["Masukan biodata dan akun anggota"]
        inputData --> clickSubmit["Klik tombol daftarkan anggota"]
        fixForm["Perbaiki isian formulir"] --> inputData
        changeAccount["Gunakan nama pengguna atau email lain"] --> inputData
    end

    subgraph Sistem["Sistem"]
        clickSubmit --> checkValid{"Apakah semua kolom diisi dengan benar?"}
        checkValid -->|"0 (Tidak)"| warnInvalid["Tampilkan peringatan kolom belum sesuai"]
        warnInvalid --> fixForm
        checkValid -->|"1 (Ya)"| checkDuplicate{"Apakah nama pengguna atau email sudah terdaftar?"}
        checkDuplicate -->|"1 (Ya)"| warnDup["Tampilkan pesan akun sudah terdaftar"]
        warnDup --> changeAccount
        checkDuplicate -->|"0 (Tidak)"| saveAccount["Buat akun anggota baru"]
        saveAccount --> success["Tampilkan pesan akun anggota berhasil dibuat"]
    end

    subgraph User["User"]
        success --> readyLogin["Akun siap digunakan anggota untuk masuk"]
        readyLogin --> finish(["Selesai"])
    end
