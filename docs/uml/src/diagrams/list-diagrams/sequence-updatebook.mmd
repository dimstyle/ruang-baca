sequenceDiagram
    autonumber
    actor C as Client (Admin)
    participant G as JwtStrategy + AdminGuard
    participant BC as BooksController
    participant BS as BooksService
    participant DB as Database

    C->>G: PUT /api/books/updatebook {buku_id, kategori_id?, judul?, penulis?, sinopsis?, penerbit?, tanggal_rilis?, stok?} (cookie access_token)
    G->>G: verify access_token dari cookie
    alt access_token tidak ada / tidak valid
        G-->>C: 401 "Unauthorized"
    else valid
        G->>DB: find accounts by id = sub
        alt bukan role admin
            G-->>C: 401 "Unauthorized"
        else admin
            G->>BC: lanjut
            BC->>BC: ValidationPipe (UpdateBookDto)
            alt body tidak valid
                BC-->>C: 400 Bad Request
            else body valid
                BC->>BS: updateBook(adminId, dto)
                BS->>DB: UPDATE books SET categories_id, judul, penulis, penerbit, sinopsis, tanggal_rilis, stok WHERE id = buku_id
                alt buku tidak ditemukan (affected rows = 0)
                    DB-->>BS: 0
                    BS-->>BC: NotFoundException
                    BC-->>C: 404 "Book not found"
                else error database
                    BS-->>BC: InternalServerErrorException
                    BC-->>C: 500 "Internal server error"
                else sukses
                    DB-->>BS: 1
                    BS-->>BC: ok
                    BC-->>C: 200 {message: "Books updated"}
                end
            end
        end
    end
