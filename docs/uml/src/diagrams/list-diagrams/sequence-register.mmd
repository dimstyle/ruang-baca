sequenceDiagram
    autonumber
    actor C as Client (Admin)
    participant G as JwtStrategy + AdminGuard
    participant AC as AuthController
    participant AS as AuthService
    participant DB as Database

    C->>G: POST /api/auth/registration {username, email, password, nama_lengkap, no_hp, alamat} (cookie access_token)
    G->>G: verify access_token dari cookie
    alt access_token tidak ada / tidak valid
        G-->>C: 401 "Unauthorized"
    else valid
        G->>DB: find accounts by id = sub
        alt bukan role admin
            G-->>C: 401 "Unauthorized"
        else admin
            G->>AC: lanjut
            AC->>AC: ValidationPipe (RegisterDto)
            alt body tidak valid
                AC-->>C: 400 Bad Request
            else body valid
                AC->>AS: register(dto)
                AS->>AS: bcrypt.hash(password)
                AS->>DB: insert accounts {username, email, password, role: "user"} + nested insert users {account_id, nama_lengkap, no_hp, alamat}
                alt data sudah ada (P2002)
                    DB-->>AS: unique constraint error (rollback)
                    AS-->>AC: ConflictException
                    AC-->>C: 409 "user data already exists"
                else error lain
                    DB-->>AS: error (rollback)
                    AS-->>AC: InternalServerErrorException
                    AC-->>C: 500 "internal server error"
                else sukses
                    DB-->>AS: account + user (commit)
                    AS-->>AC: ok
                    AC-->>C: 201 {message: "account created"}
                end
            end
        end
    end
