stateDiagram-v2
    state "Masuk sebagai Admin & buka menu laporan" as s1
    state "Klik tombol buat laporan baru" as s2
    state "Masukan keterangan dan rentang tanggal laporan" as s3
    state "Klik tombol simpan laporan" as s4
    state checkComplete <<choice>>
    state "Tampilkan peringatan belum lengkap & lengkapi formulir" as fix
    state "Tampilkan pesan laporan berhasil dibuat" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> s4
    s4 --> checkComplete
    checkComplete --> fix : 0 (Belum lengkap)
    fix --> s3
    checkComplete --> ok : 1 (Lengkap)
    ok --> [*]
