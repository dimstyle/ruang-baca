stateDiagram-v2
    state "Masuk sebagai Admin & buka daftar denda" as s1
    state "Pilih catatan denda & masukan jumlah pembayaran" as s2
    state "Klik tombol perbarui pembayaran" as s3
    state checkFound <<choice>>
    state "Tampilkan pesan data denda tidak ditemukan" as err
    state checkPaidOff <<choice>>
    state "Hapus dari daftar tagihan aktif & tampilkan pesan denda lunas" as lunas
    state "Kurangi sisa tagihan & tampilkan pesan sisa denda diperbarui" as sisa

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    err --> [*]
    checkFound --> checkPaidOff : 1 (Ditemukan)
    checkPaidOff --> lunas : 1 (Sudah lunas)
    checkPaidOff --> sisa : 0 (Belum lunas)
    lunas --> [*]
    sisa --> [*]
