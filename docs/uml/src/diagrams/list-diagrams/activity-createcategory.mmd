flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka menu kategori buku"]
        openMenu --> clickAdd[/"Klik tombol tambah kategori"/]
        clickAdd --> inputName[/"Masukan nama kategori baru"/]
        inputName --> clickSave[/"Klik tombol simpan kategori"/]
        fixName[/"Masukan kembali nama kategori"/] --> inputName
        finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        clickSave --> checkValid{"Apakah nama kategori sudah diisi?"}
        checkValid -->|"Tidak"| warnInvalid[/"Tampilkan peringatan nama kategori wajib diisi"/]
        warnInvalid --> fixName
        checkValid -->|"Ya"| saveCat["Simpan kategori buku baru"]
        saveCat --> created[/"Tampilkan pesan kategori berhasil ditambahkan"/]
        created --> finish
    end
