stateDiagram-v2
    state "Masuk sebagai Admin & buka menu kategori" as s1
    state "Klik tombol tambah kategori" as s2
    state "Masukan nama kategori dan jenis buku" as s3
    state "Klik tombol simpan kategori" as s4
    state checkFilled <<choice>>
    state "Tampilkan peringatan kolom wajib diisi & lengkapi" as fix
    state "Tampilkan pesan kategori berhasil dibuat" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> s4
    s4 --> checkFilled
    checkFilled --> fix : 0 (Belum diisi)
    fix --> s3
    checkFilled --> ok : 1 (Sudah diisi)
    ok --> [*]
