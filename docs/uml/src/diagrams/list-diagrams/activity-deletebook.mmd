flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka daftar katalog buku"]
        openMenu --> selectBook[/"Pilih buku yang ingin dihapus"/]
        selectBook --> confirmDel[/"Konfirmasi penghapusan buku"/]
        finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        confirmDel --> checkExist{"Apakah data buku ditemukan?"}
        checkExist -->|"Tidak"| notFound[/"Tampilkan pesan buku tidak ditemukan"/]
        notFound --> openMenu
        checkExist -->|"Ya"| removeBook["Hapus koleksi buku dari katalog"]
        removeBook --> deleted[/"Tampilkan pesan buku berhasil dihapus"/]
        deleted --> finish
    end
