flowchart TD
    subgraph User["User / Admin"]
        start@{ shape: sm-circ } --> openPage["Membuka halaman saat waktu akses sedang habis"]
        continueWork["Tetap melanjutkan aktivitas di halaman"] --> finish@{ shape: fr-circ }
        reLogin["Masuk kembali di halaman masuk"] --> finish
    end

    subgraph Sistem["Sistem"]
        openPage --> checkActive{"Apakah masa aktif masuk masih berlaku?"}
        checkActive -->|"Ya"| renewSession["Perpanjang akses masuk secara otomatis"]
        renewSession --> continueWork
        checkActive -->|"Tidak"| warnExpired[/"Tampilkan pesan sesi telah berakhir"/]
        warnExpired --> reLogin
    end
