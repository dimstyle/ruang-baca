flowchart TD
    start(["Mulai"]) --> loginAdmin["Masuk sebagai Admin"]
    loginAdmin --> openMenu["Buka menu daftar denda"]
    openMenu --> selectFine["Pilih catatan denda yang ingin dibayar"]
    selectFine --> inputPay[/"Masukan jumlah uang pembayaran yang diterima"/]
    inputPay --> clickUpdate[/"Klik tombol perbarui pembayaran"/]
    clickUpdate --> checkFound{"Apakah catatan denda ditemukan?"}
    checkFound -->|"Tidak"| notFound["Tampilkan pesan data denda tidak ditemukan"]
    notFound --> finish(["Selesai"])
    checkFound -->|"Ya"| checkPaidOff{"Apakah pembayaran sudah melunasi seluruh tagihan denda?"}
    checkPaidOff -->|"Ya"| paidOff["Tandai denda lunas dan hapus dari daftar tagihan aktif"]
    paidOff --> msgPaid["Tampilkan pesan denda telah lunas"]
    msgPaid --> finish
    checkPaidOff -->|"Tidak"| reduceFine["Kurangi sisa tagihan denda sesuai uang masuk"]
    reduceFine --> msgUpdated["Tampilkan pesan sisa denda berhasil diperbarui"]
    msgUpdated --> finish
