flowchart TD
    start(["Mulai"]) --> hasAccount{"Sudah punya akun anggota?"}
    hasAccount -->|"Tidak"| askAdmin["Minta Admin mendaftarkan akun"]
    askAdmin --> backLogin["Kembali ke halaman masuk"]
    backLogin --> inputAuth[/"Masukan email dan kata sandi"/]
    hasAccount -->|"Ya"| inputAuth
    inputAuth --> clickLogin[/"Klik tombol masuk"/]
    clickLogin --> checkMatch{"Apakah email dan kata sandi sesuai?"}
    checkMatch -->|"Tidak"| warnWrong["Tampilkan pesan email atau kata sandi salah"]
    warnWrong --> retryPass[/"Coba masukan kembali kata sandi"/]
    retryPass --> inputAuth
    checkMatch -->|"Ya"| toDashboard["Diarahkan ke halaman dashboard"]
    toDashboard --> finish(["Selesai"])
