stateDiagram-v2
    state "Masuk sebagai Admin & buka menu daftar laporan" as s1
    state wantFilter <<choice>>
    state "Isi tanggal awal dan tanggal akhir laporan" as s2
    state checkDates <<choice>>
    state "Tampilkan peringatan kedua tanggal harus diisi" as warnDate
    state checkList <<choice>>
    state "Tampilkan pesan belum ada laporan" as empty
    state "Tampilkan daftar laporan beserta tanggal pembuatannya" as list

    [*] --> s1
    s1 --> wantFilter
    wantFilter --> s2 : 1 (Saring tanggal)
    s2 --> checkDates
    checkDates --> warnDate : 0 (Tanggal belum lengkap)
    warnDate --> s2
    checkDates --> checkList : 1 (Tanggal lengkap)
    wantFilter --> checkList : 0 (Tanpa saring tanggal)
    checkList --> empty : 0 (Belum ada laporan)
    checkList --> list : 1 (Ada laporan)
    empty --> [*]
    list --> [*]
