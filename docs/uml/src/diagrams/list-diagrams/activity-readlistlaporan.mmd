flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka menu daftar laporan"]
        openMenu --> wantFilter{"Ingin menyaring berdasarkan rentang tanggal?"}
        wantFilter -->|"Ya"| inputDates[/"Isi tanggal awal dan tanggal akhir laporan"/]
        viewList["Melihat daftar laporan yang tersedia"] --> finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        inputDates --> checkDates{"Apakah kedua tanggal sudah diisi lengkap?"}
        checkDates -->|"Tidak"| warnDates[/"Tampilkan peringatan kedua tanggal harus diisi"/]
        warnDates --> inputDates
        checkDates -->|"Ya"| checkList{"Apakah ada laporan yang sesuai?"}
        wantFilter -->|"Tidak"| checkList
        checkList -->|"Tidak"| emptyMsg[/"Tampilkan pesan belum ada laporan"/]
        emptyMsg --> finish
        checkList -->|"Ya"| showList[/"Tampilkan daftar laporan beserta tanggal pembuatannya"/]
        showList --> viewList
    end
