erDiagram
    accounts ||--o| users : "owns"
    accounts ||--o| admins : "owns"
    accounts ||--o{ refresh_token : "has"

    users ||--o{ peminjaman : "places"

    admins ||--o{ peminjaman : "manages"
    admins ||--o{ laporan : "creates"

    categories ||--o{ books : "contains"

    books ||--o{ peminjaman : "referenced_in"

    peminjaman ||--o{ pengembalian : "has"

    pengembalian ||--o{ daftar_denda : "has"

    accounts {
        string id PK
        string email UK
        string username
        string password
        string role
        datetime created_at
    }

    users {
        string id PK
        string account_id FK
        string nama_lengkap
        string no_hp
        string alamat
        datetime created_at
        datetime updated_at
    }

    admins {
        string id PK
        string account_id FK
        string nama_lengkap
        string no_hp
        string alamat
        datetime created_at
        datetime updated_at
    }

    categories {
        int id PK
        string nama_kategori
        string jenis_buku
    }

    books {
        int id PK
        int categories_id FK
        string judul
        string penulis
        string penerbit
        string sinopsis
        datetime tanggal_rilis
        int stok
    }

    peminjaman {
        int id PK
        string user_id FK
        string admin_id FK
        int book_id FK
        datetime tanggal_peminjaman
        datetime tanggal_batas_peminjaman
    }

    pengembalian {
        int id PK
        int peminjaman_id FK
        datetime tanggal_dikembalikan
        string status_buku
    }

    refresh_token {
        int id PK
        string account_id FK
        string token
        datetime created_at
        datetime expired_at
    }

    laporan {
        int id PK
        string admin_id FK
        string keterangan
        float total_denda
        datetime tanggal_awal_peminjaman
        datetime tanggal_akhir_peminjaman
        datetime tanggal_awal_pengembalian
        datetime tanggal_akhir_pengembalian
        datetime tanggal_pembuatan_laporan
    }

    daftar_denda {
        int id PK
        int pengembalian_id FK
        float denda
        string keterangan
    }
