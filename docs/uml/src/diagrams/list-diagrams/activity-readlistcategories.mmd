stateDiagram-v2
    state "Buka halaman daftar kategori buku" as s1
    state checkAvail <<choice>>
    state "Tampilkan pesan belum ada kategori buku" as empty
    state "Tampilkan seluruh daftar kategori beserta jenis bukunya" as list

    [*] --> s1
    s1 --> checkAvail
    checkAvail --> empty : 0 (Belum tersedia)
    checkAvail --> list : 1 (Tersedia)
    empty --> [*]
    list --> [*]
