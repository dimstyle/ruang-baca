sequenceDiagram
    autonumber
    actor C as Client (Admin)
    participant G as JwtStrategy + AdminGuard
    participant PC as PeminjamanController
    participant PS as PeminjamanService
    participant DB as Database

    C->>G: POST /api/peminjaman/acceptpeminjaman {temp_peminjaman_id, tanggal_batas_peminjaman} (cookie access_token)
    G->>G: verify access_token dari cookie
    alt access_token tidak ada / tidak valid
        G-->>C: 401 "Unauthorized"
    else valid
        G->>DB: find accounts by id = sub
        alt bukan role admin
            G-->>C: 401 "Unauthorized"
        else admin
            G->>PC: lanjut
            PC->>PC: ValidationPipe (AcceptPeminjamanDto)
            alt body tidak valid
                PC-->>C: 400 Bad Request
            else body valid
                PC->>PS: acceptPeminjaman(accountId, dto)
                PS->>DB: SELECT id FROM admins WHERE account_id = sub OR id = sub LIMIT 1
                PS->>DB: SELECT id, user_id, book_id, tanggal_peminjaman FROM temp_peminjaman WHERE id = temp_peminjaman_id LIMIT 1
                alt temp_peminjaman tidak ditemukan
                    DB-->>PS: null
                    PS-->>PC: NotFoundException
                    PC-->>C: 404 "Peminjaman request not found"
                else temp_peminjaman ditemukan
                    PS->>DB: INSERT INTO peminjaman (user_id, admin_id, book_id, tanggal_peminjaman, tanggal_batas_peminjaman)
                    PS->>DB: DELETE FROM temp_peminjaman WHERE id = temp_peminjaman_id
                    alt error database
                        PS-->>PC: InternalServerErrorException
                        PC-->>C: 500 "Internal server error"
                    else sukses
                        DB-->>PS: ok
                        PS-->>PC: ok
                        PC-->>C: 200 {message: "Peminjaman admission success"}
                    end
                end
            end
        end
    end
