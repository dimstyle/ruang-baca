flowchart TD
    start(["Mulai"]) --> loginAdmin["Masuk sebagai Admin"]
    loginAdmin --> openReq["Buka menu Permintaan Pengembalian"]
    openReq --> selectReq[/"Pilih pengajuan pengembalian buku & klik Terima"/]
    selectReq --> checkCond[/"Periksa fisik buku dan pilih kondisi buku (Baik, Rusak, atau Hilang)"/]
    checkCond --> checkNeedFine{"Apakah status pengembalian Telat atau kondisi buku Rusak/Hilang?"}
    checkNeedFine -->|"Ya"| inputFine[/"Tampilkan & wajibkan isi Nominal Denda (Rp) dan Keterangan Denda (<<extend>> Create Denda)"/]
    checkNeedFine -->|"Tidak"| hideFine["Sembunyikan input denda"]
    inputFine --> clickApprove[/"Klik tombol Terima pengembalian"/]
    hideFine --> clickApprove
    clickApprove --> checkFound{"Apakah data pengajuan pengembalian ditemukan?"}
    checkFound -->|"Tidak"| notFound["Tampilkan pesan data peminjaman tidak ditemukan"]
    notFound --> finish(["Selesai"])
    checkFound -->|"Ya"| approved["Catat pengembalian buku (beserta denda jika ada) dan tampilkan pesan pengembalian diterima"]
    approved --> finish
