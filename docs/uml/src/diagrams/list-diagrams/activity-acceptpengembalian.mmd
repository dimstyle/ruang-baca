flowchart TD
    subgraph User["User"]
        reqReturn["Mengajukan pengembalian buku"]
        doneReturn["Peminjaman buku selesai dikembalikan"] --> finish(["Selesai"])
    end

    subgraph Admin["Admin"]
        start(["Mulai"]) --> openReq["Buka menu daftar pengajuan pengembalian"]
        reqReturn -.-> openReq
        openReq --> selectReq["Pilih pengajuan pengembalian dari anggota"]
        selectReq --> checkCond["Periksa fisik buku & pilih kondisi (Baik, Rusak, atau Hilang)"]
        checkCond --> clickApprove["Klik tombol setujui pengembalian"]
    end

    subgraph Sistem["Sistem"]
        clickApprove --> checkFound{"Apakah data pengajuan pengembalian ditemukan?"}
        checkFound -->|"0 (Tidak)"| notFound["Tampilkan pesan data peminjaman tidak ditemukan"]
        notFound --> finish
        checkFound -->|"1 (Ya)"| saveReturn["Catat pengembalian resmi & hapus antrean"]
        saveReturn --> msgOk["Tampilkan pesan pengembalian berhasil disetujui"]
        msgOk --> doneReturn
    end
