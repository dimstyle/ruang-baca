flowchart TD
    subgraph User["User"]
        reqReturn["Mengajukan pengembalian buku"]
        doneReturn["Peminjaman buku selesai dikembalikan (dan denda tercatat bila terlambat/rusak/hilang)"] --> finish@{ shape: fr-circ }
    end

    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openReq["Buka menu Permintaan Pengembalian"]
        reqReturn -.-> openReq
        openReq --> selectReq[/"Pilih pengajuan pengembalian & klik Terima"/]
        selectReq --> checkCond[/"Periksa fisik buku & pilih kondisi (Baik, Rusak, atau Hilang)"/]
        checkCond --> needFine{"Apakah status Telat atau kondisi Rusak/Hilang?"}
        needFine -->|"Ya"| fillFine[/"Isi Nominal Denda (Rp) & Keterangan Denda"/]
        needFine -->|"Tidak"| skipFine["Input denda disembunyikan"]
        fillFine --> clickApprove[/"Klik tombol Terima"/]
        skipFine --> clickApprove
    end

    subgraph Sistem["Sistem"]
        clickApprove --> checkFound{"Apakah data pengajuan pengembalian ditemukan?"}
        checkFound -->|"Tidak"| notFound[/"Tampilkan pesan data peminjaman tidak ditemukan"/]
        notFound --> finish
        checkFound -->|"Ya"| saveReturn["Catat pengembalian resmi, simpan daftar_denda bila ada denda, & hapus antrean temp_pengembalian"]
        saveReturn --> msgOk[/"Tampilkan pesan pengembalian buku diterima"/]
        msgOk --> doneReturn
    end
