stateDiagram-v2
    state "Masuk sebagai Admin & buka daftar pengajuan pengembalian" as s1
    state "Periksa fisik buku & pilih status kondisi buku" as s2
    state "Klik tombol setujui pengembalian" as s3
    state checkFound <<choice>>
    state "Tampilkan pesan data peminjaman tidak ditemukan" as err
    state "Catat pengembalian buku & tampilkan pesan berhasil disetujui" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    checkFound --> ok : 1 (Ditemukan)
    err --> [*]
    ok --> [*]
