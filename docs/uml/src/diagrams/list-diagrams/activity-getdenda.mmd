flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openMenu["Buka menu daftar denda"]
        viewList["Melihat daftar seluruh tagihan denda"] --> finish@{ shape: fr-circ }
    end

    subgraph Sistem["Sistem"]
        openMenu --> checkRecords{"Apakah ada catatan denda yang tersimpan?"}
        checkRecords -->|"Tidak"| emptyMsg[/"Tampilkan pesan belum ada catatan denda"/]
        emptyMsg --> finish
        checkRecords -->|"Ya"| showList[/"Tampilkan daftar denda lengkap"/]
        showList --> viewList
    end
