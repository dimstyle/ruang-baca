flowchart TD
    subgraph Admin["Admin"]
        start(["Mulai"]) --> openMenu["Buka daftar kategori buku"]
        openMenu --> selectCat["Pilih kategori yang ingin diubah"]
        selectCat --> editName["Perbarui nama kategori"]
        editName --> clickSave["Klik tombol simpan perubahan"]
        finish(["Selesai"])
    end

    subgraph Sistem["Sistem"]
        clickSave --> checkExist{"Apakah data kategori ditemukan?"}
        checkExist -->|"0 (Tidak)"| notFound["Tampilkan pesan kategori tidak ditemukan"]
        notFound --> openMenu
        checkExist -->|"1 (Ya)"| saveCat["Perbarui nama kategori buku"]
        saveCat --> updated["Tampilkan pesan kategori berhasil diperbarui"]
        updated --> finish
    end
