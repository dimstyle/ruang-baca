stateDiagram-v2
    state "Masuk sebagai Admin & buka menu kategori" as s1
    state "Pilih kategori & perbarui nama atau jenis buku" as s2
    state "Klik tombol simpan perubahan" as s3
    state checkFound <<choice>>
    state "Tampilkan pesan kategori tidak ditemukan" as err
    state "Tampilkan pesan kategori berhasil diperbarui" as ok

    [*] --> s1
    s1 --> s2
    s2 --> s3
    s3 --> checkFound
    checkFound --> err : 0 (Tidak ditemukan)
    checkFound --> ok : 1 (Ditemukan)
    err --> [*]
    ok --> [*]
