flowchart TD
    subgraph Admin["Admin"]
        start@{ shape: sm-circ } --> openDialog["Buka dialog Terima pada Permintaan Pengembalian"]
        openDialog --> selectStatus[/"Pilih kondisi buku (Baik, Rusak, atau Hilang)"/]
        selectStatus --> evalFine{"Apakah status Telat atau buku Rusak/Hilang?"}
        evalFine -->|"Tidak"| hideInput["Input denda disembunyikan"]
        evalFine -->|"Ya"| inputFine[/"Wajib isi Nominal Denda (Rp) dan Keterangan Denda"/]
        inputFine --> clickSave[/"Klik tombol Terima pengembalian"/]
    end

    subgraph Sistem["Sistem"]
        hideInput --> finish@{ shape: fr-circ }
        clickSave --> checkFound{"Apakah data pengajuan pengembalian ditemukan?"}
        checkFound -->|"Tidak"| notFound[/"Tampilkan pesan data peminjam tidak ditemukan"/]
        checkFound -->|"Ya"| saveFine["Simpan pengembalian & catat tagihan denda baru ke daftar_denda"]
        saveFine --> created[/"Tampilkan pesan pengembalian & denda berhasil dicatat"/]
    end

    subgraph User["User"]
        notFound --> finish
        created --> hasFine["Anggota memiliki tagihan denda tercatat pada menu Denda"]
        hasFine --> finish
    end
