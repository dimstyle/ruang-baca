flowchart TD
    subgraph Admin["Admin"]
        start(["Mulai"]) --> openMenu["Buka menu pengembalian buku atau daftar denda"]
        openMenu --> selectReturn["Pilih catatan pengembalian buku yang terkena denda"]
        selectReturn --> inputFine["Masukan nominal denda dan keterangan alasan"]
        inputFine --> clickSave["Klik tombol simpan denda"]
    end

    subgraph Sistem["Sistem"]
        clickSave --> checkFound{"Apakah data pengembalian ditemukan?"}
        checkFound -->|"0 (Tidak)"| notFound["Tampilkan pesan data peminjam tidak ditemukan"]
        checkFound -->|"1 (Ya)"| saveFine["Simpan catatan tagihan denda baru"]
        saveFine --> created["Tampilkan pesan denda berhasil dicatat"]
    end

    subgraph User["User"]
        notFound --> finish(["Selesai"])
        created --> hasFine["Anggota memiliki tagihan denda tercatat"]
        hasFine --> finish
    end
